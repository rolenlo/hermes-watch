<?xml version="1.0" encoding="utf-8"?>
<!-- Tailscale serve is usually HTTPS. Cleartext is allowed so a direct
     http://100.x.x.x:8453 (Tailscale IP + relay port) still works in Phase 1. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
